# ============================================================================
# OpenCode Studio - Environment Variables
# ============================================================================

# API Keys (at least one required)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=./data/opencode.db

# Vector Store
CHROMA_URL=http://localhost:8000

# Web UI
NEXT_PUBLIC_API_URL=http://localhost:3001

# Security
SANDBOX_MODE=ask_edit

# Debug
DEBUG=false
